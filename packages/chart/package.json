{
  "name": "@tidal-ts/chart",
  "version": "0.2.0",
  "private": false,
  "description": "TimeSeriesChart \u2014 a multi-row time-series chart on @pond-ts/charts, plus the series and settings vocabulary and the prepare step. Theme, colours and settings arrive as props.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tidal-app/tidal-ts.git",
    "directory": "packages/chart"
  },
  "homepage": "https://github.com/tidal-app/tidal-ts#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "storybook": "storybook dev -p 6009 --no-open",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@pond-ts/charts": "^0.69.0",
    "@pond-ts/financial": "^0.69.0",
    "pond-ts": "^0.69.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@tidal-ts/core": "workspace:*"
  },
  "devDependencies": {
    "@pond-ts/charts": "^0.69.0",
    "@pond-ts/financial": "^0.69.0",
    "@pond-ts/process": "0.69.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/react-vite": "^8.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "pond-ts": "^0.69.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.5.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
